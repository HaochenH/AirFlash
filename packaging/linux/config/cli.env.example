# Optional environment for the AirFlash systemd user service.
# Read from ~/.config/airflash/cli.env (and cli-<instance>.env for templates).
# Uncomment and adapt only what you need; the unit already sets a runtime
# directory under XDG_RUNTIME_DIR.

# The receiver's AirPlay port when the unit's config file omits it.
#AIRFLASH_DEBUG=1

# Audio session: a user unit inherits DBUS_SESSION_BUS_ADDRESS and
# XDG_RUNTIME_DIR from the login session, which is what PipeWire and
# PulseAudio clients need. Set these only if you run the service outside a
# session (for example from cron) and know the values.
#DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
#XDG_RUNTIME_DIR=/run/user/1000
