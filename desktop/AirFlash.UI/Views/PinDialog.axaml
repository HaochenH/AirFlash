<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AirFlash.UI"
        x:Class="AirFlash.UI.Views.PinDialog"
        Title="{loc:Text 'AirPlay PIN'}"
        Width="380" Height="210"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="20" VerticalAlignment="Center">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Classes="BodyText" Margin="0,0,0,16" />
    <TextBox x:Name="PinBox" Watermark="1234" MaxLength="8" />
    <TextBlock x:Name="Error" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{loc:Text 'OK'}" Click="OnOk" IsDefault="True" MinWidth="84" Margin="0,0,8,0" />
      <Button Content="{loc:Text 'Cancel'}" Click="OnCancel" IsCancel="True" MinWidth="84" />
    </StackPanel>
  </StackPanel>
</Window>
